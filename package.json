{
  "name": "fastapi-full-stack-template",
  "private": true,
  "workspaces": [
    "frontend",
    "extension",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run --workspace frontend dev",
    "dev:extension": "npm run --workspace extension dev",
    "build": "npm run --workspace frontend build",
